{
  "expo": {
    "name": "AffectionPlus",
    "slug": "affectionplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "affectionplus",
      "com.affectionplus.app"
    ],
    "userInterfaceStyle": "automatic",
    "primaryColor": "#580378",
    "ios": {
      "bundleIdentifier": "com.affectionplus.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "AffectionPlus",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "fr",
          "en",
          "de",
          "es",
          "it",
          "pt",
          "nl",
          "pl",
          "tr"
        ],
        "CFBundleDevelopmentRegion": "fr"
      },
      "scheme": [
        "com.googleusercontent.apps.271367624923-5cr1gk0rs0q9r86uj7q5m7llkfp45tlf"
      ],
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.affectionplus.app",
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "backgroundColor": "#580378",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#580378",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Votre position sert une seule fois à trouver la maternité la plus proche ; elle n'est ni envoyée ni conservée.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json",
      "it": "./locales/it.json",
      "pt": "./locales/pt.json",
      "nl": "./locales/nl.json",
      "pl": "./locales/pl.json",
      "tr": "./locales/tr.json"
    }
  }
}
